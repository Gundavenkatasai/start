PORT=5000
NODE_ENV=development
# Database URL (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="replace-with-your-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace-with-your-refresh-token-secret-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"

# Payments (Stripe for USD/GBP/EUR, Razorpay for INR, or sandbox fallback)
STRIPE_SECRET_KEY="sk_test_sandbox"
STRIPE_WEBHOOK_SECRET="whsec_sandbox"
RAZORPAY_KEY_ID="rzp_test_sandbox"
RAZORPAY_KEY_SECRET="rzp_secret_sandbox"

# Email & Storage
RESEND_API_KEY=""
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
